# All optional for local development. With no DATABASE_URL the server uses an
# embedded Postgres (PGlite) stored in server/.data - nothing to install.
# These are read from the real environment (set them in your shell or in the
# hosting provider's dashboard); this file is documentation only.

# PostgreSQL connection string (required in production), e.g. from Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session tokens (required in production):
# JWT_SECRET=change-me-to-a-long-random-string

# PORT=3000
# NODE_ENV=production

# Tests only: run the suite against a real Postgres instead of embedded PGlite.
# WARNING: every table in this database is TRUNCATED. Never point it at production.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xyzbank_test
